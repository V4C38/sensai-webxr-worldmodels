<style>
  .panel-container {
    align-items: center;
    padding: 2;
    width: 28;
    display: flex;
    flex-direction: column;
    background-color: #0d0221;
    border-color: #7b2ff2;
    border-width: 0.15;
    border-radius: 1.2;
  }

  .logo {
    width: 24;
    height: 7;
    object-fit: contain;
  }

  .sub-heading {
    font-size: 1.2;
    color: #c4b5fd;
    text-align: center;
    margin-top: 0.3;
  }

  .divider {
    width: 80%;
    height: 0.08;
    margin-top: 0.8;
    margin-bottom: 0.8;
    background-color: #7b2ff2;
  }

  .event-line {
    font-size: 2;
    color: #fbbf24;
    text-align: center;
    font-weight: medium;
  }

  #load-splat-button,
  #xr-button {
    width: 100%;
    padding: 0.8;
    margin-top: 0.8;
    border-radius: 0.8;
    border-width: 0;
    font-size: 1.4;
    font-weight: bold;
    text-align: center;
    cursor: pointer;
  }

  #load-splat-button {
    font-size: 2;
    font-weight: bold;
    text-align: center;
    background-color: #7b2ff2;
    color: #f5f3ff;
  }

  #xr-button {
    background-color: #fbbf24;
    color: #0d0221;
  }
</style>
<div class="panel-container">
  <img src="/logo.png" alt="Logo" class="logo" />
  <span class="sub-heading">WebXR with IWSDK</span>
  <div class="divider"></div>
